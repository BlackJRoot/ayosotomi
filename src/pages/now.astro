---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, parseInlineLinks } from '../lib/utils';

const linkClass =
  'text-link underline decoration-border underline-offset-2 transition-colors duration-300 hover:text-accent';

const nowEntries = await getCollection('now');
const current = nowEntries.sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
)[0];

const sections = [
  { label: 'Working on', items: current.data.workingOn },
  { label: 'Learning', items: current.data.learning },
  { label: 'Reading', items: current.data.reading },
  { label: 'Tools', items: current.data.tools },
];

// Lighter "outside of work" extras -- optional, so only shown when present,
// and rendered together in one condensed line rather than full sections.
const extras = [
  { label: 'Watching', items: current.data.watching },
  { label: 'Doing', items: current.data.doing },
].filter((extra): extra is { label: string; items: string[] } => !!extra.items?.length);
---

<BaseLayout
  title="Now — Ayomiposi Sotomi"
  description="What I'm currently working on, learning, reading, and using."
>
  <div class="mx-auto max-w-2xl space-y-12 px-6 py-20">
    <section>
      <h1 class="font-serif text-4xl font-medium text-text md:text-5xl">
        Now
      </h1>
      <p class="mt-4 text-sm text-text-secondary">
        Last updated: {formatDate(current.data.updatedAt)}
      </p>
    </section>

    <section class="space-y-8">
      {
        sections.map(({ label, items }) => (
          <div>
            <h2 class="mb-3 text-sm uppercase tracking-wider text-text-secondary">
              {label}
            </h2>
            <ul class="space-y-2">
              {items.map((item) => (
                <li class="text-text">
                  →{' '}
                  {parseInlineLinks(item).map((seg) =>
                    seg.href ? (
                      <a href={seg.href} class={linkClass} target="_blank" rel="noopener noreferrer">
                        {seg.text}
                      </a>
                    ) : (
                      seg.text
                    )
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    {
      extras.length > 0 && (
        <section class="border-t border-border pt-6 text-sm text-text-secondary">
          {extras.map(({ label, items }, i) => (
            <>
              {i > 0 && <span class="mx-2">·</span>}
              <span>
                <span class="text-text-secondary/80">{label}:</span>{' '}
                <span class="text-text">
                  {items.map((item, itemIndex) => (
                    <>
                      {itemIndex > 0 && ', '}
                      {parseInlineLinks(item).map((seg) =>
                        seg.href ? (
                          <a href={seg.href} class={linkClass} target="_blank" rel="noopener noreferrer">
                            {seg.text}
                          </a>
                        ) : (
                          seg.text
                        )
                      )}
                    </>
                  ))}
                </span>
              </span>
            </>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>
