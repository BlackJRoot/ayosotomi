---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Now: latest entry, used for the "Currently" pulse under the hero.
const nowEntries = await getCollection('now');
const currentNow = nowEntries.sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
)[0];

// First non-placeholder item from a list. Placeholders are either an
// em-dash prefix ("— add what you're reading —") or fully [bracketed]
// (the Now template's convention) -- skip both so an unfilled-in Now
// entry never leaks placeholder text onto the homepage pulse.
function isPlaceholder(s: string): boolean {
  const t = s.trim();
  return t.startsWith('—') || (t.startsWith('[') && t.endsWith(']'));
}

// Terminal-prompt typewriter (replaces the old static "Currently" pulse):
// every real Now item becomes a shell-style command the hero types out,
// cycling. Data comes from the same Now entry, so `npm run now` / the CMS
// keeps the hero current automatically.
function realItems(items: string[] | undefined): string[] {
  return (items ?? []).filter((s) => s && !isPlaceholder(s));
}
const nowCommands: string[] = currentNow
  ? [
      ...realItems(currentNow.data.workingOn).map(
        (s) => `now --working-on "${s.toLowerCase()}"`
      ),
      ...realItems(currentNow.data.learning).map(
        (s) => `now --learning "${s.toLowerCase()}"`
      ),
      ...realItems(currentNow.data.reading).map(
        (s) => `now --reading "${s.toLowerCase()}"`
      ),
    ].slice(0, 6)
  : [];

// Writing: newest essay leads the featured slot; fall back to newest post of any kind.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const featured = posts.find((p) => p.data.category === 'essay') ?? posts[0];

// Optional cover thumbnail: src/assets/covers/<post-slug>.<ext>, optimized via <Image>.
// No cover for a post → the featured block simply renders without one.
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/covers/*.{jpeg,jpg,png,webp}',
  { eager: true }
);
const featuredSlug = featured?.id.split('/').pop();
const coverImage = featuredSlug
  ? Object.entries(covers).find(
      ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === featuredSlug
    )?.[1].default
  : undefined;

// Numbered section lists (the "01/02" motif): newest five posts and
// projects, rebuilt from the collections on every build -- new content
// shows up here automatically.
const recentPosts = posts.slice(0, 5);
const recentProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.startedAt.valueOf() - a.data.startedAt.valueOf())
  .slice(0, 5);
const num = (i: number) => String(i + 1).padStart(2, '0');

const beds = [
  { href: '/writing', title: 'Writing', note: `${posts.length} essays & notes` },
  { href: '/projects', title: 'Projects', note: 'homelab & builds' },
  { href: '/now', title: 'Now', note: 'a living page' },
];
---

<BaseLayout
  title="Ayomiposi Sotomi"
  description="Writer. Builder. Security-minded human."
>
  <div class="relative mx-auto max-w-2xl lg:max-w-4xl px-6 py-16">
    <svg
      aria-hidden="true"
      viewBox="0 0 80 120"
      class="pointer-events-none absolute right-6 top-14 hidden w-14 text-accent opacity-40 sm:block"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    >
      <path d="M40 118 C40 90 40 60 40 20" />
      <path d="M40 70 C24 64 18 50 20 38 C34 40 42 54 40 70Z" />
      <path d="M40 54 C56 48 62 34 60 22 C46 24 38 38 40 54Z" />
      <path d="M40 90 C26 86 20 74 22 64 C34 66 42 78 40 90Z" />
    </svg>

    <section>
      <h1
        class="max-w-[22ch] font-serif text-3xl font-normal leading-snug text-text sm:text-4xl"
      >
        <span class="text-text-secondary">Hi, I'm</span> Ayomiposi
        <span class="text-text-secondary">—</span> a writer, builder, and security-minded
        human.
      </h1>

      {
        nowCommands.length > 0 && (
          <a
            href="/now"
            id="now-terminal"
            data-commands={JSON.stringify(nowCommands)}
            class="mt-6 flex items-baseline gap-2 overflow-hidden rounded-lg border border-border bg-code-bg/60 px-3.5 py-2 font-mono text-[13px] transition-colors duration-300 hover:border-accent"
            aria-label="What I'm up to right now — see the Now page"
          >
            <span aria-hidden="true" class="shrink-0 text-accent">~ $</span>
            <span
              id="now-terminal-text"
              class="whitespace-nowrap text-text-secondary"
            >
              {nowCommands[0]}
            </span>
            <span
              aria-hidden="true"
              id="now-terminal-caret"
              class="inline-block h-[1em] w-[2px] shrink-0 self-center animate-caret bg-accent"
            />
          </a>
        )
      }
    </section>

    <section class="mt-10 grid grid-cols-1 gap-3.5 sm:grid-cols-3">
      {
        beds.map((bed) => (
          <a
            href={bed.href}
            class="group block rounded-xl border border-border p-4 transition-colors duration-300 hover:border-accent"
          >
            <span class="block font-serif text-lg text-text transition-colors duration-300 group-hover:text-accent">
              {bed.title}
            </span>
            <span class="mt-1 block text-sm text-text-secondary">{bed.note}</span>
          </a>
        ))
      }
    </section>

    {
      featured && (
        <section class="mt-8 flex gap-5">
          {coverImage && (
            <a href={`/writing/${featured.id}/`} class="shrink-0">
              <Image
                src={coverImage}
                alt={`Cover image for ${featured.data.title}`}
                width={208}
                height={256}
                class="h-32 w-[104px] rounded-lg border border-border object-cover"
              />
            </a>
          )}
          <div class="border-l-[3px] border-accent pl-5">
            <p class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">
              Latest essay
            </p>
            <a href={`/writing/${featured.id}/`} class="group block">
              <h2 class="mt-1.5 font-serif text-xl text-text transition-colors duration-300 group-hover:text-accent">
                {featured.data.title}
              </h2>
            </a>
            <p class="mt-2 font-serif text-[15px] italic text-text-secondary">
              {featured.data.description}
            </p>
            <a
              href={`/writing/${featured.id}/`}
              class="mt-2 inline-block text-sm text-link transition-colors duration-300 hover:text-accent"
            >
              Read the essay →
            </a>
          </div>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="mt-14">
          <div class="flex items-baseline gap-3 border-b border-border pb-2">
            <span class="font-mono text-xs tracking-widest text-accent">01</span>
            <h2 class="font-serif text-2xl font-medium text-text">Writing</h2>
            <a
              href="/writing"
              class="ml-auto text-sm text-link transition-colors duration-300 hover:text-accent"
            >
              All essays →
            </a>
          </div>
          <ul>
            {recentPosts.map((post, i) => (
              <li class="border-b border-border last:border-b-0">
                <a
                  href={`/writing/${post.id}/`}
                  class="group flex items-baseline gap-3.5 py-3"
                >
                  <span class="font-mono text-[11px] text-text-secondary">
                    {num(i)}
                  </span>
                  <span class="font-serif text-[17px] text-text transition-colors duration-300 group-hover:text-accent">
                    {post.data.title}
                  </span>
                  <span class="ml-auto shrink-0 text-sm text-text-secondary">
                    {post.data.publishedAt.toLocaleDateString('en-US', {
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentProjects.length > 0 && (
        <section class="mt-12">
          <div class="flex items-baseline gap-3 border-b border-border pb-2">
            <span class="font-mono text-xs tracking-widest text-accent">02</span>
            <h2 class="font-serif text-2xl font-medium text-text">Projects</h2>
            <a
              href="/projects"
              class="ml-auto text-sm text-link transition-colors duration-300 hover:text-accent"
            >
              All projects →
            </a>
          </div>
          <ul>
            {recentProjects.map((project, i) => (
              <li class="border-b border-border last:border-b-0">
                <a
                  href={`/projects/${project.id}/`}
                  class="group flex items-baseline gap-3.5 py-3"
                >
                  <span class="font-mono text-[11px] text-text-secondary">
                    {num(i)}
                  </span>
                  <span class="font-serif text-[17px] text-text transition-colors duration-300 group-hover:text-accent">
                    {project.data.title}
                  </span>
                  <span class="ml-auto shrink-0 text-sm text-text-secondary">
                    {project.data.startedAt.getFullYear()}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // Hero terminal typewriter: cycles the Now page's items as shell-style
  // commands. Static fallback (first command, fully typed) is server-
  // rendered above, so no-JS and reduced-motion users lose nothing.
  const terminal = document.getElementById('now-terminal');
  const textEl = document.getElementById('now-terminal-text');

  if (terminal && textEl) {
    const commands: string[] = JSON.parse(
      terminal.getAttribute('data-commands') ?? '[]'
    );
    // Typing runs for everyone by explicit choice (2026-08-17),
    // including prefers-reduced-motion -- an earlier build swapped text
    // instantly for reduced-motion users and it read as broken
    // "blipping". Note: Linux with GTK animations disabled reports
    // reduce browser-wide, so that mode is overrepresented locally.
    if (commands.length > 1) {
      const TYPE_MS = 34;
      const ERASE_MS = 14;
      const HOLD_MS = 4000;
      let index = 0;

      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

      async function loop() {
        for (;;) {
          await sleep(HOLD_MS);
          const current = commands[index];
          index = (index + 1) % commands.length;
          const next = commands[index];
          // Erase only back to the longest prefix the two commands
          // share, then type the remainder. Within a category that
          // keeps `now --learning "` fixed and rewrites just the item;
          // at a category boundary it erases back through the flag
          // (to the shared `now --`) before typing the new one.
          let common = 0;
          while (
            common < current.length &&
            common < next.length &&
            current[common] === next[common]
          ) {
            common++;
          }
          for (let i = current.length; i > common; i--) {
            textEl!.textContent = current.slice(0, i - 1);
            await sleep(ERASE_MS);
          }
          for (let i = common + 1; i <= next.length; i++) {
            textEl!.textContent = next.slice(0, i);
            await sleep(TYPE_MS);
          }
        }
      }
      loop();
    }
  }
</script>
