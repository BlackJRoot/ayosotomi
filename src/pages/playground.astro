---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tagColorClass } from '../lib/utils';
import {
  publicServices,
  stacks,
  containersRunning,
  homelabRepoUrl,
} from '../data/playground';

const serviceCount = stacks.reduce((n, s) => n + s.services.length, 0);
const stats = [
  { value: String(containersRunning), label: 'Containers' },
  { value: String(serviceCount), label: 'Services' },
  { value: String(stacks.length), label: 'Stacks' },
  { value: '1', label: 'Laptop' },
];
---

<BaseLayout
  title="Playground — Ayomiposi Sotomi"
  description="Services I self-host from my homelab."
  noindex
>
  <div class="mx-auto max-w-2xl lg:max-w-4xl px-6 py-20">
    <p class="font-mono text-[11px] uppercase tracking-widest text-accent">
      Playground
    </p>
    <h1 class="mt-2 font-serif text-4xl font-medium text-text md:text-5xl">
      The lab
    </h1>
    <p class="mt-4 text-lg text-text-secondary">
      Services I self-host on Docker, from a laptop. Not a major server build —
      this is the experimenting-and-learning phase, and that's the point.
    </p>

    {
      publicServices.length > 0 && (
        <section class="mt-12">
          <div class="flex items-center gap-2.5 border-b border-border pb-2">
            <span class="h-1.5 w-1.5 rounded-full bg-visited ring-[3px] ring-visited/20" />
            <h2 class="font-serif text-2xl font-medium text-text">
              Public Services
            </h2>
            <span class="ml-auto font-mono text-[11px] text-text-secondary">
              {publicServices.length} live
            </span>
          </div>
          <p class="mt-3 text-sm text-text-secondary">
            Live and publicly accessible. Go ahead, click around.
          </p>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {publicServices.map((svc) => (
              <a
                href={svc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-lg border border-border p-3.5 transition-colors duration-300 hover:border-accent"
              >
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-visited ring-[3px] ring-visited/20" />
                  <span class="font-serif text-lg text-text transition-colors duration-300 group-hover:text-accent">
                    {svc.name}
                  </span>
                  <span class="rounded-full bg-visited/15 px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-visited">
                    Live
                  </span>
                  <span class="ml-auto text-text-secondary transition-colors duration-300 group-hover:text-accent">
                    ↗
                  </span>
                </div>
                <p class="mt-1.5 text-sm text-text-secondary">{svc.note}</p>
                {svc.tech && svc.tech.length > 0 && (
                  <ul class="mt-2.5 flex flex-wrap gap-1.5">
                    {svc.tech.map((t) => (
                      <li class={`tag-pill ${tagColorClass(t)}`}>{t}</li>
                    ))}
                  </ul>
                )}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-12">
      <div class="flex items-center gap-2.5 border-b border-border pb-2">
        <span
          class="h-1.5 w-1.5 rounded-full bg-visited ring-[3px] ring-visited/20"
        ></span>
        <h2 class="font-serif text-2xl font-medium text-text">
          Behind the Firewall
        </h2>
        <span class="ml-auto font-mono text-[11px] text-text-secondary">
          {serviceCount} services · {stacks.length} stacks
        </span>
      </div>
      <p class="mt-3 text-sm text-text-secondary">
        Not publicly accessible, but these keep the lab running.
      </p>

      {
        stacks.map((stack) => (
          <div class="mt-6">
            <p class="flex items-baseline gap-2 font-mono text-[11px] uppercase tracking-widest text-accent">
              {stack.name}
              <span class="normal-case tracking-normal text-text-secondary">
                · {stack.services.length}
              </span>
            </p>
            <div class="mt-2.5 grid gap-2.5 sm:grid-cols-2">
              {stack.services.map((svc) => (
                <div class="rounded-lg border border-border p-3.5">
                  <div class="flex items-center gap-2">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-visited ring-[3px] ring-visited/20" />
                    <span class="font-serif text-lg text-text">{svc.name}</span>
                  </div>
                  <p class="mt-1.5 text-sm text-text-secondary">{svc.note}</p>
                  {svc.tech && svc.tech.length > 0 && (
                    <ul class="mt-2.5 flex flex-wrap gap-1.5">
                      {svc.tech.map((t) => (
                        <li class={`tag-pill ${tagColorClass(t)}`}>{t}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="mt-12 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="rounded-lg border border-border px-2 py-4 text-center">
            <p class="font-mono text-2xl tracking-tight text-text">
              {stat.value}
            </p>
            <p class="mt-1.5 font-mono text-[10px] uppercase tracking-wider text-text-secondary">
              {stat.label}
            </p>
          </div>
        ))
      }
    </section>

    {
      homelabRepoUrl && (
        <section class="mt-12">
          <a
            href={homelabRepoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-lg border border-border px-6 py-8 text-center transition-colors duration-300 hover:border-accent"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="mx-auto h-6 w-6 fill-current text-text"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span class="mt-3 block font-serif text-xl font-medium text-text">
              Open Source Homelab
            </span>
            <p class="mx-auto mt-2 max-w-sm text-sm text-text-secondary">
              The Docker Compose files and configuration behind all of this are
              public. Copy anything useful.
            </p>
            <span class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-1.5 font-mono text-xs text-text transition-colors duration-300 group-hover:border-accent group-hover:text-accent">
              View on GitHub <span aria-hidden="true">↗</span>
            </span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>
