---
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();

// One newsletter ask per page (2026-08-18): the footer form is hidden
// where it would duplicate or intrude — the homepage (kept bare), post
// pages (PostLayout has its own end-of-post form; the footer one made
// every article ask twice), and /now, /about, /feed (removed per the
// human). It remains on index-ish pages: /writing, /projects (+ project
// details), privacy, playground, 404.
const path = Astro.url.pathname;
const isHome = path === '/';
const isPostPage = /^\/writing\/.+/.test(path);
const showForm =
  !isHome &&
  !isPostPage &&
  !/^\/(now|about|feed)(\/|$)/.test(path);
const heading = path.startsWith('/projects')
  ? "Curious what's next? New write-ups by email."
  : 'New writing, straight to your inbox.';
---

<footer
  class="mx-auto mt-16 w-full max-w-2xl lg:max-w-4xl border-t border-border px-6 py-12 text-sm text-text-secondary transition-colors duration-300"
>
  {showForm && <NewsletterForm heading={heading} />}

  <div class={`flex items-center justify-between ${showForm ? 'mt-10 border-t border-border pt-8' : ''}`}>
    <div class="flex items-center gap-3.5">
      <p>&copy; {year} Ayomiposi Sotomi.</p>
      <a
        href="https://github.com/BlackJRoot"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="text-text-secondary transition-colors duration-300 hover:text-accent"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-[17px] w-[17px] fill-current">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a
        href="https://x.com/_lifeofayo"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (Twitter)"
        class="text-text-secondary transition-colors duration-300 hover:text-accent"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-[15px] w-[15px] fill-current">
          <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" />
        </svg>
      </a>
    </div>
    <div class="flex gap-6">
      <a href="/privacy" class="hover:text-accent transition-colors duration-300">
        Privacy
      </a>
      <a href="/feed" class="hover:text-accent transition-colors duration-300">
        RSS
      </a>
    </div>
  </div>
</footer>
