---
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();
---

<footer
  class="mx-auto mt-16 w-full max-w-2xl border-t border-border px-6 py-12 text-sm text-text-secondary transition-colors duration-300"
>
  <NewsletterForm />

  <div class="mt-10 flex items-center justify-between border-t border-border pt-8">
    <p>&copy; {year} Ayomiposi Sotomi.</p>
    <div class="flex gap-6">
      <a href="/privacy" class="hover:text-accent transition-colors duration-300">
        Privacy
      </a>
      <a href="/rss.xml" class="hover:text-accent transition-colors duration-300">
        RSS
      </a>
    </div>
  </div>
</footer>
