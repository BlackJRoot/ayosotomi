---
import NewsletterForm from './NewsletterForm.astro';

const year = new Date().getFullYear();

// Section-aware footer copy: "Get new posts by email" reads fine on a
// writing page but oddly on /about or /projects, so pick the heading
// based on where the reader actually is instead of one line for the
// whole site.
const path = Astro.url.pathname;
const heading = path.startsWith('/projects')
  ? "Curious what's next? New write-ups by email."
  : path.startsWith('/about') || path.startsWith('/now')
    ? 'Want more of this? Occasional emails, no spam.'
    : 'New writing, straight to your inbox.';
---

<footer
  class="mx-auto mt-16 w-full max-w-2xl border-t border-border px-6 py-12 text-sm text-text-secondary transition-colors duration-300"
>
  <NewsletterForm heading={heading} />

  <div class="mt-10 flex items-center justify-between border-t border-border pt-8">
    <p>&copy; {year} Ayomiposi Sotomi.</p>
    <div class="flex gap-6">
      <a href="/privacy" class="hover:text-accent transition-colors duration-300">
        Privacy
      </a>
      <a href="/rss.xml" class="hover:text-accent transition-colors duration-300">
        RSS
      </a>
    </div>
  </div>
</footer>
