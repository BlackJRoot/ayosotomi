---
// Quiet share row under the slow clap: copy-link + WhatsApp + X +
// LinkedIn as plain intent URLs — no third-party scripts, nothing loads
// unless a reader actually clicks. On devices with the native share
// sheet (Web Share API, mobile), the three network icons collapse into
// a single share button; copy-link stays either way.
interface Props {
  url: string;
  title: string;
}
const { url, title }: Props = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(`${title} — ${url}`);
const targets = [
  {
    name: 'WhatsApp',
    href: `https://wa.me/?text=${encodedText}`,
    icon: 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35ZM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 7 2.9 9.83 9.83 0 0 1 2.89 7c0 5.45-4.44 9.88-9.9 9.88Zm8.42-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.47-8.41Z',
  },
  {
    name: 'X',
    href: `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodedUrl}`,
    icon: 'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z',
  },
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z',
  },
];
---

<div class="mt-5 flex flex-col items-center gap-4" id="share-row" data-url={url} data-title={title}>
  <span aria-hidden="true" class="h-px w-4 bg-border"></span>
  <div class="flex items-center gap-5">
    <span class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">
      share
    </span>
    <button
      type="button"
      id="share-copy"
      aria-label="Copy link"
      class="cursor-pointer border-0 bg-transparent p-0 text-text-secondary transition-colors duration-300 hover:text-accent"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
    </button>
    <span id="share-copied" class="hidden font-mono text-[10px] text-visited">link copied ✓</span>
    {
      targets.map((t) => (
        <a
          href={t.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Share on ${t.name}`}
          data-share-network
          class="text-text-secondary transition-colors duration-300 hover:text-accent"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
            <path d={t.icon} />
          </svg>
        </a>
      ))
    }
    <button
      type="button"
      id="share-native"
      aria-label="Share"
      class="hidden cursor-pointer border-0 bg-transparent p-0 text-text-secondary transition-colors duration-300 hover:text-accent"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
        <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
      </svg>
    </button>
  </div>
</div>

<script>
  const row = document.getElementById('share-row');
  if (row) {
    const url = row.dataset.url ?? location.href;
    const title = row.dataset.title ?? document.title;
    const copyBtn = document.getElementById('share-copy');
    const copied = document.getElementById('share-copied');
    const nativeBtn = document.getElementById('share-native');

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copied?.classList.remove('hidden');
        setTimeout(() => copied?.classList.add('hidden'), 2200);
      } catch {
        /* clipboard unavailable -- the network links still work */
      }
    });

    // Mobile with a native share sheet: collapse the network icons into
    // one system share button (copy-link stays).
    if (
      nativeBtn &&
      'share' in navigator &&
      window.matchMedia('(pointer: coarse)').matches
    ) {
      row
        .querySelectorAll('[data-share-network]')
        .forEach((a) => a.classList.add('hidden'));
      nativeBtn.classList.remove('hidden');
      nativeBtn.addEventListener('click', () => {
        void navigator.share({ title, url }).catch(() => {});
      });
    }
  }
</script>
