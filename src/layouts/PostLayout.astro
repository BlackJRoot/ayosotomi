---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ReadingTime from '../components/ReadingTime.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import SlowClap from '../components/SlowClap.astro';
import { formatDate, tagColorClass } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
  related: CollectionEntry<'blog'>[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { post, readingTime, related, prevPost, nextPost } = Astro.props;

// Reuse the homepage's featured-cover convention (src/assets/covers/<slug>.ext)
// as the post's social-share (OG/Twitter) image, since it's the only cover
// image already associated with a post.
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/covers/*.{jpeg,jpg,png,webp}',
  { eager: true }
);
const postSlug = post.id.split('/').pop();
const coverImage = postSlug
  ? Object.entries(covers).find(
      ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === postSlug
    )?.[1].default
  : undefined;
const ogImage = coverImage ? (await getImage({ src: coverImage })).src : undefined;
---

<BaseLayout
  title={`${post.data.title} — Ayomiposi Sotomi`}
  description={post.data.description}
  image={ogImage}
  type="article"
>
  <article class="mx-auto max-w-2xl lg:max-w-4xl px-6 py-20">
    <header>
      <p class="text-sm uppercase tracking-wider text-text-secondary">
        {post.data.category.replace('-', ' ')}
      </p>
      <h1 class="mt-2 font-serif text-4xl font-medium text-text md:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-4 text-sm text-text-secondary">
        {formatDate(post.data.publishedAt)} · <ReadingTime minutes={readingTime} />
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class={`tag-pill ${tagColorClass(tag)}`}>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="prose prose-neutral mt-10 max-w-none lg:max-w-2xl prose-blockquote:my-8 prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:pl-6 prose-blockquote:font-serif prose-blockquote:text-xl prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-text"
    >
      <slot />
    </div>

    <SlowClap slug={post.id} />

    <div class="mt-16 border-t border-border pt-10">
      <NewsletterForm heading="Enjoyed this? New writing, straight to your inbox." />
    </div>

    {
      (prevPost || nextPost) && (
        <nav class="mt-16 flex items-start justify-between gap-6 border-t border-border pt-8">
          <div class="text-left">
            {prevPost && (
              <a
                href={`/writing/${prevPost.id}/`}
                class="group block text-sm text-text-secondary transition-colors duration-300 hover:text-accent"
              >
                <span class="block">← Previous</span>
                <span class="mt-1 block text-text group-hover:text-accent">
                  {prevPost.data.title}
                </span>
              </a>
            )}
          </div>
          <div class="text-right">
            {nextPost && (
              <a
                href={`/writing/${nextPost.id}/`}
                class="group block text-sm text-text-secondary transition-colors duration-300 hover:text-accent"
              >
                <span class="block">Next →</span>
                <span class="mt-1 block text-text group-hover:text-accent">
                  {nextPost.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-4 text-sm uppercase tracking-wider text-text-secondary">
            Related
          </h2>
          <div class="space-y-8">
            {related.map((relatedPost) => (
              <PostCard post={relatedPost} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
